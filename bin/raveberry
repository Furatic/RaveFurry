#!/usr/bin/env python3
"""Command line program that handles the Raveberry installation."""
import getpass
import os
import shutil
import subprocess
import sys
import argparse
import pathlib
import importlib.util
from typing import Optional, Tuple, Dict, Any
import secrets
import string
import threading
import time
import urllib.error
import urllib.request


class Raveberry:
    """Command line program that handles the Raveberry installation."""

    def __init__(self) -> None:
        try:
            import raveberry  # pylint: disable=import-outside-toplevel,import-self

            self.module_found = True
            self.module_directory = os.path.dirname(raveberry.__file__)
        except ModuleNotFoundError:
            self.module_found = False
            self.module_directory = None

        self.local_directory = str(pathlib.Path(__file__).parent.parent / "backend")
        self.directory: Optional[str] = None
        self.module_used: Optional[bool] = None
        self.default_config: Optional[str] = None
        self.used_config: Optional[str] = None
        self.django_ready = False
        self.console_lock = None

    def main(self) -> None:
        """Parses the commandline and executes the corresponding method."""
        parser = argparse.ArgumentParser(
            description="""\
        A multi-user music server with a focus on participation.
        For more info visit https://github.com/raveberry/raveberry""",
            formatter_class=argparse.RawTextHelpFormatter,
            # formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        parser.add_argument(
            "command",
            nargs="?",
            help="""\
run         run a basic version of Raveberry
visualizer  run only the local OBS background/audio analyzer
install     install Raveberry into the system
help        show this help and exit""",
        )
        parser.add_argument(
            "--version", "-v", action="store_true", help="print version and exit"
        )
        parser.add_argument(
            "--config-file",
            "-c",
            type=str,
            help="specify a config file to use for install",
        )
        parser.add_argument(
            "--confirm-config",
            action="store_true",
            help="do not prompt to confirm the config file",
        )
        parser.add_argument(
            "--local",
            action="store_true",
            help="use the local folder even if the module is installed",
        )
        parser.add_argument(
            "--celery",
            action="store_true",
            help="use Celery to handle long running tasks",
        )
        parser.add_argument(
            "--nomopidy",
            action="store_true",
            help="don't start mopidy if it isn't running",
        )
        parser.add_argument(
            "--use-default-password-i-promise-ill-change-it",
            action="store_true",
            help="don't ask for an admin password and use 'admin'",
        )
        args = parser.parse_args()

        if args.local or not self.module_found:
            self.module_used = False
            self.directory = self.local_directory
            default_config = os.path.join(self.local_directory, "config/raveberry.yaml")
        else:
            self.module_used = True
            self.directory = self.module_directory
            default_config = os.path.join(
                self.module_directory, "config/raveberry.yaml"
            )

        self.default_config = os.path.abspath(default_config)
        self.used_config = self.default_config
        if args.config_file:
            self.used_config = os.path.abspath(args.config_file)
        assert self.directory
        os.chdir(self.directory)

        if args.version:
            self.version()

        if not args.command:
            parser.print_help()
            sys.exit(1)

        command = args.command.lstrip("-")
        choices = ["run", "install", "visualizer"]
        if command not in choices:
            parser.print_help()
            sys.exit(1)
        elif command == "run":
            self.run_server(args.nomopidy, args.celery)
        elif command == "visualizer":
            # Standalone Linux/service deployments get the same isolated recovery
            # as `run`, without initializing Django or starting music playback.
            if self.directory not in sys.path:
                sys.path.insert(0, self.directory)
            from visualizer.supervisor import VisualizerCompanion
            companion = VisualizerCompanion(self.directory)
            try:
                companion.start()
                while companion.thread and companion.thread.is_alive():
                    companion.thread.join(timeout=.5)
            except KeyboardInterrupt:
                pass
            finally:
                companion.close()
            sys.exit(companion.exit_code)
        elif command == "install":
            self.install(
                config_confirmed=args.confirm_config,
                use_default_password=args.use_default_password_i_promise_ill_change_it,
            )
        else:
            print("unknown command")
            sys.exit(1)

    def version(self) -> None:
        """Returns the version of the used Raveberry instance.
        Distinguishes between system, user and local instance."""
        with open("VERSION", encoding="utf-8") as version_file:
            version = version_file.read().strip()
        if self.module_used:
            if os.path.isdir("/usr/local/sbin/raveberry"):
                version += " (system)"
            else:
                version += " (user)"
        else:
            version += " (local)"
        print(version)
        sys.exit(0)

    @staticmethod
    def _start_processes(
        nomopidy: bool,
        use_celery: bool,
    ) -> Tuple[Optional[subprocess.Popen], Optional[subprocess.Popen]]:
        mopidy: Optional[subprocess.Popen] = None
        celery: Optional[subprocess.Popen] = None
        if not nomopidy:
            try:
                subprocess.check_call("pgrep mopidy".split(), stdout=subprocess.DEVNULL)
            except subprocess.CalledProcessError:
                print("mopidy not yet running, waiting for it to come up...")
                mopidy = subprocess.Popen(  # pylint: disable=consider-using-with
                    ["mopidy"], stderr=subprocess.PIPE, text=True
                )
                # wait until mopidy started its server
                assert mopidy.stderr
                for line in mopidy.stderr:
                    line = line.strip()
                    print(line)
                    if "HTTP server running" in line:
                        break
        if use_celery:
            try:
                subprocess.check_call(
                    ["pgrep", "-f", "celery -A core.tasks"], stdout=subprocess.DEVNULL
                )
            except subprocess.CalledProcessError:
                celery = subprocess.Popen(  # pylint: disable=consider-using-with
                    "python3 manage.py startcelery".split(),
                    env={"DJANGO_DEBUG": "1", **os.environ},
                    stdin=subprocess.DEVNULL,
                )
        return mopidy, celery

    def _ensure_django(self) -> None:
        if self.django_ready:
            return

        assert self.directory
        if self.directory not in sys.path:
            sys.path.insert(0, self.directory)

        os.environ.setdefault("DJANGO_SETTINGS_MODULE", "main.settings")
        os.environ.setdefault("DJANGO_DEBUG", "1")

        import django  # pylint: disable=import-outside-toplevel
        django.setup()
        self.django_ready = True

    @staticmethod
    def _random_admin_password(length: int = 12) -> str:
        alphabet = string.ascii_letters + string.digits + "!@#$%^&*()-_=+"
        return "".join(secrets.choice(alphabet) for _ in range(length))

    def _ensure_runtime_admin_credentials(self) -> Tuple[str, str]:
        self._ensure_django()
        from core import user_manager  # pylint: disable=import-outside-toplevel

        username, password = user_manager.ensure_builtin_admin(
            rotate_if_unset=True
        )
        self._close_django_db_connections()
        return username, password

    def _ensure_runtime_moderator_credentials(self) -> Tuple[str, str]:
        self._ensure_django()
        from core import user_manager  # pylint: disable=import-outside-toplevel

        username, password = user_manager.ensure_builtin_moderator(
            rotate_if_unset=True
        )
        self._close_django_db_connections()
        return username, password

    def _close_django_db_connections(self) -> None:
        if not self.django_ready:
            return
        from django.db import connections  # pylint: disable=import-outside-toplevel
        connections.close_all()
    
    def _login_link(self, path: str) -> str:
        self._ensure_django()
        from django.conf import settings as conf  # pylint: disable=import-outside-toplevel
    
        base = (conf.FURATIC_PUBLIC_URL or "").rstrip("/")
        self._close_django_db_connections()
    
        if base:
            return f"{base}{path}"
        return f"http://127.0.0.1:8080{path}"
    
    def _get_site_mode(self) -> str:
        self._ensure_django()
        from core import site_mode  # pylint: disable=import-outside-toplevel
        return site_mode.get_mode()

    def _set_site_mode(self, mode: str) -> None:
        self._ensure_django()
        from core import site_mode  # pylint: disable=import-outside-toplevel

        site_mode.set_mode(mode)

    def _ensure_runtime_defaults(self) -> None:
        self._ensure_django()
        from core.settings import storage  # pylint: disable=import-outside-toplevel

        storage.put("interactivity", storage.Interactivity.full_voting)
        self._close_django_db_connections()

    def _get_saved_playback_state(self) -> Tuple[int, int]:
        self._ensure_django()
        from core.models import CurrentSong, QueuedSong  # pylint: disable=import-outside-toplevel

        queued_count = QueuedSong.objects.count()
        current_count = CurrentSong.objects.count()
        self._close_django_db_connections()
        return queued_count, current_count

    def _send_operator_command(self, command: str) -> None:
        self._ensure_django()
        from core.musiq import playback  # pylint: disable=import-outside-toplevel

        playback.request_operator_command(command)
        self._close_django_db_connections()

    def _prompt_event_queue_choice(self, queued_count: int, current_count: int) -> str:
        import msvcrt  # pylint: disable=import-outside-toplevel

        assert self.console_lock is not None
        with self.console_lock:
            self._clear_status_line()
            print(
                f"Saved playback state found: {queued_count} queued song(s), "
                f"{current_count} current song.",
                flush=True,
            )
            print(
                "Press K to keep the queue and continue, or C to clear it and start fresh.",
                flush=True,
            )

        while True:
            key = msvcrt.getwch().lower()
            if key == "k":
                return "keep"
            if key == "c":
                return "clear"

    @staticmethod
    def _status_text(mode: str) -> str:
        label = "Event Mode" if mode == "event" else "After Hours"
        return f"[E] Event Mode  [A] After Hours  [H] Help  [Q] Quit   Current: {label}"

    def _clear_status_line(self) -> None:
        sys.stdout.write("\r" + (" " * 160) + "\r")
        sys.stdout.flush()

    def _draw_status_line(self) -> None:
        try:
            mode = self._get_site_mode()
        except Exception:  # pylint: disable=broad-except
            mode = "event"
    
        sys.stdout.write("\r" + self._status_text(mode))
        sys.stdout.flush()

    def _console_message(self, message: str) -> None:
        assert self.console_lock is not None
        with self.console_lock:
            self._clear_status_line()
            print(message, flush=True)
            self._draw_status_line()

    def _print_login_block(
        self,
        label: str,
        link: str,
        username: str,
        password: str,
    ) -> None:
        print("\n" + "=" * 78)
        print(f" FURATIC {label} LOGIN")
        print(f" Link:     {link}")
        print(f" Username: {username}")
        print(f" Password: {password}")
        print("=" * 78 + "\n")

    def _waitress_command(self) -> str:
        return (
            "import os; "
            "os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'main.settings'); "
            "from waitress import serve; "
            "from django.contrib.staticfiles.handlers import StaticFilesHandler; "
            "from main.wsgi import application as django_application; "
            "application = StaticFilesHandler(django_application); "
            "serve("
            "application, "
            "host='127.0.0.1', "
            "port=8080, "
            "threads=160, "
            "connection_limit=450, "
            "channel_timeout=60, "
            "expose_tracebacks=False"
            ")"
        )

    def _start_windows_web_server(
        self,
        additional_env: Dict[str, str],
    ) -> subprocess.Popen:
        while not self._wait_for_database_ready(timeout=30):
            message = (
                "PostgreSQL is not accepting connections yet. "
                "Waiting before starting web server..."
            )
            if self.console_lock is not None:
                self._console_message(message)
            else:
                print(message, flush=True)
            time.sleep(2)

        return subprocess.Popen(
            [sys.executable, "-c", self._waitress_command()],
            env={
                **self._windows_postgres_environment(),
                "DJANGO_DEBUG": "1",
                "PYTHONUNBUFFERED": "1",
                "FURATIC_LOCAL_HTTP_SERVER": "1",
                **additional_env,
            },
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )

    def _stop_windows_web_server(self, server: subprocess.Popen) -> None:
        if server.poll() is not None:
            return

        server.terminate()
        try:
            server.wait(timeout=5)
        except subprocess.TimeoutExpired:
            server.kill()
            server.wait(timeout=5)

    def _web_server_healthy(self) -> bool:
        try:
            with urllib.request.urlopen(
                "http://127.0.0.1:8080/_healthz/",
                timeout=3,
            ) as response:
                return 200 <= response.status < 300
        except (OSError, urllib.error.URLError, TimeoutError):
            return False

    @staticmethod
    def _windows_postgres_environment() -> Dict[str, str]:
        env = dict(os.environ)
        host = (env.get("POSTGRES_HOST") or "127.0.0.1").lower()
        if os.name == "nt" and host in {"127.0.0.1", "localhost", "::1"}:
            if not env.get("PGGSSENCMODE"):
                env["PGGSSENCMODE"] = "disable"
        return env

    def _database_healthy(self) -> bool:
        host = os.environ.get("POSTGRES_HOST", "127.0.0.1")
        port = os.environ.get("POSTGRES_PORT", "54329")
        database = os.environ.get("POSTGRES_DB", "raveberry")

        try:
            result = subprocess.run(
                ["pg_isready", "-h", host, "-p", port, "-d", database],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=3,
                check=False,
                env=self._windows_postgres_environment(),
            )
            return result.returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False

    def _start_local_database_if_possible(self) -> bool:
        pgdata = os.environ.get("RAVEBERRY_PGDATA", "")
        pglog = os.environ.get("RAVEBERRY_PGLOG", "")
        port = os.environ.get("POSTGRES_PORT", "54329")

        if not pgdata:
            return False

        command = ["pg_ctl", "-D", pgdata]
        if pglog:
            command.extend(["-l", pglog])
        command.extend(["-o", f"-p {port}", "-w", "start"])

        try:
            result = subprocess.run(
                command,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=20,
                check=False,
            )
            return result.returncode == 0 or self._database_healthy()
        except (OSError, subprocess.SubprocessError):
            return False

    def _wait_for_database_ready(self, timeout: float = 30.0) -> bool:
        deadline = time.monotonic() + timeout
        attempted_start = False

        while time.monotonic() < deadline:
            if self._database_healthy():
                return True

            if not attempted_start:
                attempted_start = True
                self._start_local_database_if_possible()

            time.sleep(0.5)

        return self._database_healthy()

    def _wait_for_web_server_ready(
        self,
        server: subprocess.Popen,
        timeout: float = 15.0,
    ) -> bool:
        deadline = time.monotonic() + timeout

        while time.monotonic() < deadline:
            if server.poll() is not None:
                return False

            if self._web_server_healthy():
                return True

            time.sleep(0.25)

        return False

    def _read_restart_request(self) -> str:
        self._ensure_django()
        from core import redis  # pylint: disable=import-outside-toplevel
        from redis.exceptions import RedisError  # pylint: disable=import-outside-toplevel

        try:
            return str(redis.connection.get("web_restart_requested") or "")
        except RedisError:
            # A brief Redis outage must not terminate the supervisor and audio.
            # The HTTP health check reports persistent runtime failures.
            return ""
        finally:
            self._close_django_db_connections()

    def _clear_restart_request(self) -> None:
        self._ensure_django()
        from core import runtime_restart  # pylint: disable=import-outside-toplevel

        try:
            runtime_restart.clear_restart_request()
        finally:
            self._close_django_db_connections()

    def _start_output_thread(self, server: subprocess.Popen) -> threading.Thread:
        def pump_output() -> None:
            assert server.stdout is not None
            for raw_line in server.stdout:
                line = raw_line.rstrip("\r\n")
                with self.console_lock:
                    self._clear_status_line()
                    print(line, flush=True)
                    self._draw_status_line()

        output_thread = threading.Thread(target=pump_output, daemon=True)
        output_thread.start()
        return output_thread

    def _supervise_windows_web_server(
        self,
        server: subprocess.Popen,
        additional_env: Dict[str, str],
    ) -> None:
        import msvcrt  # pylint: disable=import-outside-toplevel

        try:
            self._start_output_thread(server)
            self._console_message("FURATIC controls ready. Press H for help.")

            bad_health_checks = 0
            bad_database_checks = 0
            last_health_check = 0.0
            last_database_check = 0.0

            while True:
                if server.poll() is not None:
                    self._console_message("Web server exited. Restarting...")
                    self._clear_restart_request()
                    server = self._start_windows_web_server(additional_env)
                    self._start_output_thread(server)
                    bad_health_checks = 0
                    bad_database_checks = 0
                    last_health_check = time.monotonic()
                    self._wait_for_web_server_ready(server)
                    continue

                restart_reason = self._read_restart_request()
                if restart_reason:
                    self._console_message(
                        f"Restarting web server safely: {restart_reason}"
                    )

                    # Keep the restart request set while stopping the old child so
                    # playback cannot start the next song in the old process.
                    self._stop_windows_web_server(server)

                    # The old child is gone now. Acknowledge the request before
                    # starting the new child, otherwise the supervisor will loop.
                    self._clear_restart_request()

                    server = self._start_windows_web_server(additional_env)
                    self._start_output_thread(server)
                    bad_health_checks = 0
                    bad_database_checks = 0
                    last_health_check = time.monotonic()
                    self._wait_for_web_server_ready(server)
                    continue

                now = time.monotonic()
                if now - last_database_check >= 5:
                    last_database_check = now

                    if self._database_healthy():
                        bad_database_checks = 0
                    else:
                        bad_database_checks += 1

                    # Native playback may still be healthy during a brief
                    # database delay. Require consecutive failed probes before
                    # replacing the shared web/audio process.
                    if bad_database_checks >= 3:
                        self._console_message(
                            "PostgreSQL failed repeated readiness checks. "
                            "Restarting local database and web server..."
                        )

                        self._stop_windows_web_server(server)
                        self._clear_restart_request()

                        while not self._wait_for_database_ready(timeout=30):
                            self._console_message(
                                "PostgreSQL is still unavailable. Retrying database recovery..."
                            )
                            time.sleep(2)

                        server = self._start_windows_web_server(additional_env)
                        self._start_output_thread(server)
                        bad_health_checks = 0
                        bad_database_checks = 0
                        last_health_check = time.monotonic()
                        last_database_check = time.monotonic()
                        self._wait_for_web_server_ready(server)
                        continue

                now = time.monotonic()
                if now - last_health_check >= 10:
                    last_health_check = now
                    if self._web_server_healthy():
                        bad_health_checks = 0
                    else:
                        bad_health_checks += 1
                        if bad_health_checks >= 3:
                            self._console_message(
                                "Web server health check failed repeatedly. Restarting..."
                            )
                            self._stop_windows_web_server(server)
                            self._clear_restart_request()
                            server = self._start_windows_web_server(additional_env)
                            self._start_output_thread(server)
                            bad_health_checks = 0
                            bad_database_checks = 0
                            last_health_check = time.monotonic()
                            self._wait_for_web_server_ready(server)
                            continue

                if msvcrt.kbhit():
                    key = msvcrt.getwch()
                    if key in ("\x00", "\xe0"):
                        if msvcrt.kbhit():
                            msvcrt.getwch()
                        time.sleep(0.05)
                        continue

                    key = key.lower()
                    if key == "a":
                        self._send_operator_command("pause_for_afterhours")
                        self._set_site_mode("afterhours")
                        self._console_message(
                            "Switched public site to After Hours mode. Playback is paused."
                        )
                    elif key == "e":
                        current_mode = self._get_site_mode()

                        if current_mode == "afterhours":
                            queued_count, current_count = self._get_saved_playback_state()

                            if queued_count > 0 or current_count > 0:
                                choice = self._prompt_event_queue_choice(
                                    queued_count, current_count
                                )

                                if choice == "clear":
                                    self._send_operator_command("clear_for_event")
                                    self._set_site_mode("event")
                                    self._console_message(
                                        "Switched public site to Event Mode. Previous queue was cleared."
                                    )
                                else:
                                    self._set_site_mode("event")
                                    self._send_operator_command("resume_from_afterhours")
                                    self._console_message(
                                        "Switched public site to Event Mode. Previous queue was kept."
                                    )
                            else:
                                self._set_site_mode("event")
                                self._console_message("Switched public site to Event Mode.")
                        else:
                            self._set_site_mode("event")
                            self._console_message("Already in Event Mode.")
                    elif key == "h":
                        self._console_message(
                            "Hotkeys: E = Event Mode, A = After Hours, Q = Quit."
                        )
                    elif key == "q":
                        self._console_message("Stopping Raveberry...")
                        break

                time.sleep(0.05)
        finally:
            # Own the latest child, including replacements after a restart.
            # run_server still holds the original child reference.
            self._stop_windows_web_server(server)

    def run_server(self, nomopidy=False, use_celery=False) -> None:
        """Run Raveberry with user privileges."""
        spec = importlib.util.find_spec("django")
        if spec is None:
            print("Please install required dependencies:")
            print("\t pip3 install raveberry[run]")
            sys.exit(1)

        if not os.path.isfile("db.sqlite3"):
            print("first time running raveberry, preparing...")
            self.user_prepare()

        print("This is the basic raveberry version using a debug server.")
        print("To install with all features run `raveberry install`")

        mopidy, celery = self._start_processes(nomopidy, use_celery)

        additional_env = {}
        if not use_celery:
            additional_env["DJANGO_NO_CELERY"] = "1"

        server = None
        visualizer = None
        try:
            subprocess.check_call(
                [sys.executable, "manage.py", "migrate"],
                env={"DJANGO_DEBUG": "1", **os.environ},
            )

            self._ensure_runtime_defaults()

            admin_username, admin_password = self._ensure_runtime_admin_credentials()
            moderator_username, moderator_password = self._ensure_runtime_moderator_credentials()
            additional_env["FURATIC_MOD_PASSWORD"] = moderator_password

            self._close_django_db_connections()

            admin_link = self._login_link("/admin/")
            moderator_link = self._login_link("/moderator/")

            # Independent of the web/playback child: no between-song restarts,
            # database polling or recovery actions are added to music playback.
            try:
                from visualizer.supervisor import VisualizerCompanion
                visualizer = VisualizerCompanion(self.directory)
                visualizer.start()
            except Exception as error:  # an optional feature cannot block music
                print(f"OBS visualizer unavailable: {error}", flush=True)

            if os.name == "nt":
                self.console_lock = threading.Lock()

                self._print_login_block(
                    "ADMIN",
                    admin_link,
                    admin_username,
                    admin_password,
                )
                self._print_login_block(
                    "MODERATOR",
                    moderator_link,
                    moderator_username,
                    moderator_password,
                )

                server = self._start_windows_web_server(additional_env)
                time.sleep(0.75)
                self._supervise_windows_web_server(server, additional_env)
            else:
                self._print_login_block(
                    "ADMIN",
                    admin_link,
                    admin_username,
                    admin_password,
                )
                self._print_login_block(
                    "MODERATOR",
                    moderator_link,
                    moderator_username,
                    moderator_password,
                )

                subprocess.call(
                    [sys.executable, "manage.py", "runserver", "127.0.0.1:8080"],
                    env={**os.environ, "DJANGO_DEBUG": "1", **additional_env},
                )

        except KeyboardInterrupt:
            pass
        finally:
            if visualizer is not None:
                try:
                    visualizer.close()
                except Exception as error:
                    print(f"OBS visualizer cleanup: {error}", flush=True)
            if server and server.poll() is None:
                server.terminate()
                try:
                    server.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    server.kill()

            if mopidy:
                mopidy.terminate()

            if celery:
                subprocess.call(["pkill", "-9", "-f", "celery -A core.tasks"])

    @staticmethod
    def user_prepare() -> None:
        """Prepare the userspace version of Raveberry."""
        if os.name == "nt":
            print("first time running raveberry on Windows, preparing...")
            subprocess.check_call(
                [sys.executable, "manage.py", "migrate"],
                env={"DJANGO_DEBUG": "1", **os.environ},
            )
            return

        required_packages = [("ffmpeg", "ffmpeg"), ("mopidy", "mopidy")]
        missing_packages = []
        for executable, package_name in required_packages:
            if not shutil.which(executable):
                missing_packages.append(package_name)
        if missing_packages:
            print(
                "please install missing packages: sudo apt-get install -y "
                + " ".join(missing_packages)
            )
            sys.exit(1)

        subprocess.call(["/bin/bash", "setup/user_prepare.sh"])

    def _load_config(self, config_confirmed: bool = False) -> Dict[str, Any]:
        import yaml  # pylint: disable=import-outside-toplevel

        if not config_confirmed:
            print(
                f"""This install will change system files, backups are recommended.
    For advanced features (e.g. Spotify, Visualization, Hotspot) edit the config before continuing.
        config: {self.used_config}"""
            )
            if not self.module_used:
                assert self.directory
                print("Using folder: " + self.directory)

            answer = input("Continue? [Y/n] ")
            while answer not in ["", "Y", "y", "Yes", "yes", "N", "n", "No", "no"]:
                answer = input('Please answers "yes" or "no": ')
            if answer in ["N", "n", "No", "no"]:
                sys.exit(0)

        assert self.used_config
        assert self.default_config
        if self.used_config != self.default_config:
            shutil.copyfile(self.used_config, self.default_config)

        with open(self.used_config, encoding="utf-8") as config_file:
            config = yaml.safe_load(config_file)

        return config

    @staticmethod
    def _set_admin_password(
        config: Dict[str, Any], use_default_password: bool = False
    ) -> None:
        db_exists = not subprocess.call(
            'sudo -u postgres psql -lqt | cut -d \\| -f 1 | grep -qw "raveberry"',
            shell=True,
            stderr=subprocess.DEVNULL,
        )
        if config["db_backup"] or db_exists:
            pass
        else:
            if use_default_password:
                os.environ["ADMIN_PASSWORD"] = "admin"
            else:
                while True:
                    admin_password = getpass.getpass("Set admin password: ")
                    admin_password_confirmed = getpass.getpass(
                        "Confirm admin password: "
                    )
                    if admin_password == admin_password_confirmed:
                        os.environ["ADMIN_PASSWORD"] = admin_password
                        break
                    print("Passwords didn't match")

    def install(self, config_confirmed=False, use_default_password=False) -> None:
        """Install Raveberry into the system."""
        if not shutil.which("rsync"):
            print("Please install rsync")
            print("\tsudo apt install rsync")
            sys.exit(1)
        if not shutil.which("ansible-playbook"):
            print("Please install the required dependencies:")
            print("\tpip3 install raveberry[install]")
            print("If you already installed them, try adding them to PATH:")
            print('\texport PATH="$HOME/.local/bin:$PATH"')
            sys.exit(1)

        config = self._load_config(config_confirmed=config_confirmed)

        self._set_admin_password(config, use_default_password=use_default_password)

        returncode = subprocess.call(
            [
                "ansible-playbook",
                "-i",
                "localhost,",
                "-e",
                "ansible_python_interpreter=auto_silent",
                "--connection",
                "local",
                "setup/system_install.yaml",
            ]
        )
        if returncode == 0:
            print(
                """
        Finished!

        Raveberry was successfully installed.
        You can now visit http://raveberry.local/"""
            )
        else:
            sys.exit(returncode)


if __name__ == "__main__":
    Raveberry().main()

